<?xml version="1.0" encoding="utf-8"?>
<!-- 长按桌面图标出现的快捷方式：直接打开 App 内圈题 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="latest" android:enabled="true" android:icon="@drawable/ic_lasso"
        android:shortcutShortLabel="@string/shortcut_latest">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="app.quanwen" android:targetClass="app.quanwen.CircleActivity">
            <extra android:name="source" android:value="latest" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="camera" android:enabled="true" android:icon="@drawable/ic_card"
        android:shortcutShortLabel="@string/shortcut_camera">
        <intent android:action="android.intent.action.VIEW"
            android:targetPackage="app.quanwen" android:targetClass="app.quanwen.CircleActivity">
            <extra android:name="source" android:value="camera" />
        </intent>
    </shortcut>
</shortcuts>
